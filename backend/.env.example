# App
DEBUG=false

# Storage
MAX_UPLOAD_SIZE_MB=50

# OCR engine (PP-StructureV3 pipeline)
OCR_PIPELINE=PP-StructureV3
OCR_LANG=en
# Layout model; use PP-DocLayout-S for faster CPU inference
OCR_LAYOUT_MODEL=PP-DocLayout_plus-L
OCR_DET_MODEL=PP-OCRv5_mobile_det
OCR_REC_MODEL=PP-OCRv5_mobile_rec
# gpu requires paddlepaddle-gpu (pinned in pyproject.toml); cpu requires plain paddlepaddle
OCR_DEVICE=gpu
OCR_ENABLE_MKLDNN=false
OCR_CPU_THREADS=4
OCR_USE_DOC_ORIENTATION_CLASSIFY=true
OCR_USE_DOC_UNWARPING=false
OCR_USE_TEXTLINE_ORIENTATION=true
OCR_USE_TABLE_RECOGNITION=true
OCR_USE_FORMULA_RECOGNITION=false
OCR_USE_CHART_RECOGNITION=false
OCR_USE_SEAL_RECOGNITION=false
OCR_USE_REGION_DETECTION=true

# LLM extraction (OpenAI-compatible /chat/completions API)
# Examples: OpenAI (https://api.openai.com/v1), DeepSeek (https://api.deepseek.com),
# or any local server exposing an OpenAI-compatible endpoint (e.g. Ollama/LM Studio).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2000
LLM_USE_JSON_MODE=true
